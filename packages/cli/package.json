{
  "name": "@pinout/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Pinout.",
  "type": "module",
  "bin": {
    "pinout": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./connection": {
      "types": "./dist/connectionArgs.d.ts",
      "default": "./dist/connectionArgs.js"
    },
    "./script": {
      "types": "./dist/runScript.d.ts",
      "default": "./dist/runScript.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@pinout/core": "*",
    "commander": "^12.1.0"
  }
}
