{
  "name": "@pinout/cli",
  "version": "0.1.0",
  "description": "Command-line interface for Pinout.",
  "type": "module",
  "bin": {
    "pinout": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./connection": {
      "types": "./dist/connectionArgs.d.ts",
      "default": "./dist/connectionArgs.js"
    },
    "./script": {
      "types": "./dist/runScript.d.ts",
      "default": "./dist/runScript.js"
    }
  },
  "scripts": {
    "build": "tsc -b"
  },
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pinoutlabs/pinout.git"
  },
  "dependencies": {
    "@pinout/core": "*",
    "@pinout/generator": "*",
    "commander": "^12.1.0",
    "@pinout/daemon": "*",
    "@pinout/module-host": "*",
    "@pinout/discovery": "*"
  }
}
