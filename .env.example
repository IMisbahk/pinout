# Default serial port (optional; CLI and examples fall back to --port)
PINOUT_PORT=/dev/cu.usbserial-0001

# Serial baud rate (default: 115200)
PINOUT_BAUD=115200

# Request timeout in milliseconds (default: 5000)
PINOUT_TIMEOUT=5000

# Log level: debug | info | warn | error (default: info)
PINOUT_LOG_LEVEL=info

# MCP server: use simulator instead of serial (default: unset)
# PINOUT_MOCK=1
